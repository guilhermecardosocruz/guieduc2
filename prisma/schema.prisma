generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String // no banco está NOT NULL
  email     String   @unique
  password  String   @map("passwordHash") // coluna real é passwordHash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassGroup {
  id        String              @id @default(cuid())
  name      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  classes   ClassGroupOnClass[]
}

model Class {
  id          String              @id @default(cuid())
  name        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  students    Student[]
  lessons     Lesson[]
  attendances Attendance[]
  groups      ClassGroupOnClass[]
}

model ClassGroupOnClass {
  classId    String
  groupId    String
  assignedAt DateTime @default(now())

  class Class      @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([classId, groupId])
  @@index([groupId])
}

model Student {
  id          String       @id @default(cuid())
  name        String
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cpf         String?
  contact     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[] @relation("StudentAttendances")
}

model Lesson {
  id              String       @id @default(cuid())
  classId         String
  class           Class        @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  number          Int? // existe unique (classId, number), pode iniciar nulo até setar
  title           String
  content         String?
  objetivos       String?      @map("objectives") // mapeia para coluna objectives
  recursos        String?      @map("resources") // mapeia para coluna resources
  desenvolvimento String?      @map("activities") // mapeia para coluna activities
  bncc            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attendances     Attendance[] @relation("LessonAttendances")

  @@unique([classId, number])
}

model Attendance {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  lessonId String?
  lesson   Lesson? @relation("LessonAttendances", fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  studentId String
  student   Student @relation("StudentAttendances", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  present   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
