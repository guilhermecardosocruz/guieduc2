generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]
}

model Class {
  id          String       @id @default(cuid())
  name        String
  groupId     String?
  group       ClassGroup?  @relation(fields: [groupId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  students    Student[]
  lessons     Lesson[]
  attendances Attendance[]
}

model Student {
  id          String       @id @default(cuid())
  classId     String
  class       Class        @relation(fields: [classId], references: [id])
  name        String
  cpf         String?
  contact     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[] @relation("StudentAttendances")
}

model Lesson {
  id              String       @id @default(cuid())
  classId         String
  class           Class        @relation(fields: [classId], references: [id])
  number          Int
  title           String?
  content         String?
  objetivos       String?
  desenvolvimento String?
  recursos        String?
  bncc            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attendances     Attendance[] @relation("LessonAttendances")

  @@unique([classId, number])
}

model Attendance {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id])

  lessonId String?
  lesson   Lesson? @relation("LessonAttendances", fields: [lessonId], references: [id])

  studentId String
  student   Student @relation("StudentAttendances", fields: [studentId], references: [id])

  present   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
